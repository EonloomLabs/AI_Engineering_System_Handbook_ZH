      ],
      "question": "少花了钱却多失败，究竟算不算进步？",
      "chain": "baseline → paired trials → regression → decision",
      "exercise": "预先登记成功下限、超时和任务划分；同时报告收益、退化与未知。",
      "display_number": "09"
    },
    {
      "unit": 10,
      "stage": 3,
      "stage_name": "优化黑盒",
      "title": "把每个等待和调用计入整项任务",
      "pages": [
        "foundations/38.html",
        "chapters/25.html"
      ],
      "question": "Token减少，为什么端到端仍可能更慢？",
      "chain": "queue + model + tools + retry + verification",

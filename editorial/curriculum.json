        "foundations/22.html",
        "foundations/24.html",
        "chapters/09.html"
      ],
      "question": "助手说“修好了”，怎样查到文件真的改了？",
      "chain": "read → decide → act → observe → verify",
      "exercise": "预测每条事件由模型、宿主还是工具产生；再检查真实文件与验收记录。",
      "display_number": "01"
    },
    {
      "unit": 2,
      "stage": 1,
      "stage_name": "观察系统",
      "title": "把完成条件写成可以复查的证据",
      "pages": [
        "foundations/34.html",
        "foundations/35.html",
        "chapters/22.html"
      ],
      "question": "测试退出0、回答很自信，能算任务成功吗？",
      "chain": "task → artifact → grader → result",
      "exercise": "保留修改前失败与修改后通过，并把无关失败、跳过和环境错误分别记录。",
      "display_number": "02"
    },
    {
      "unit": 3,
      "stage": 2,
      "stage_name": "构建循环",
      "title": "把模型提议变成受控的工具调用",
      "pages": [
        "foundations/23.html",
        "foundations/25.html",
        "chapters/10.html",
        "chapters/11.html"
      ],
      "question": "一段JSON何时才有资格改变文件？",
      "chain": "schema → dispatch → effect → result",
      "exercise": "逐个核对调用ID、参数类型、路径范围、终态和结果回填。",
      "display_number": "03"
    },
    {
      "unit": 4,
      "stage": 2,
      "stage_name": "构建循环",
      "title": "为每次请求组装正确的上下文",

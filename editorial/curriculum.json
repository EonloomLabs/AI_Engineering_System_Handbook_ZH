        "foundations/26.html",
        "chapters/13.html",
        "foundations/32.html",
        "chapters/19.html",
        "chapters/12.html"
      ],
      "question": "规则在磁盘上，为什么Agent仍不知道？",
      "chain": "discover → select → load → request → use",
      "exercise": "比较真正发出的请求；分开规则、证据、工具目录、技能正文与权限。",
      "display_number": "04"
    },
    {
      "unit": 5,
      "stage": 2,
      "stage_name": "构建循环",
      "title": "让检索结果成为足够的证据",
      "pages": [
        "foundations/28.html",
        "foundations/29.html",
        "foundations/30.html",
        "chapters/15.html",
        "chapters/16.html",
        "chapters/17.html"
      ],
      "question": "相似度最高的文档，为什么仍可能答非所问？",
      "chain": "index → retrieve → rank → validate → cite",
      "exercise": "把文档版本、权限、符号位置和主张逐项对应，保留一个相关但不可用的反例。",
      "display_number": "05"
    },
    {
      "unit": 6,
      "stage": 2,
      "stage_name": "构建循环",
      "title": "跨轮状态、压缩与长期记忆",
      "pages": [
        "foundations/27.html",
        "foundations/31.html",
        "chapters/14.html",
        "chapters/18.html"
      ],
      "question": "上下文缩短后，禁止条件和未知动作会不会消失？",
      "chain": "history → snapshot → summary → validate → install",
      "exercise": "在摘要生成期间追加新事件；检验原始证据、实时后缀与授权变化如何保留。",
      "display_number": "06"
    },
    {
      "unit": 7,
      "stage": 2,

.concept-note dl{margin:0}.concept-note dt{font-weight:700;margin-top:11px}.concept-note dt:first-child{margin-top:0}.concept-note dd{margin:4px 0 0}.concept-note a{text-decoration:none}.concept-micro{display:block;color:#596964;font-size:.95em;margin-top:5px}

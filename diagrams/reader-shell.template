.route-card h3{margin:7px 0 10px;font-size:20px}.route-card p{font-size:15px;margin:9px 0}
.chapter-list{margin:15px 0 27px}.chapter-list>a{display:flex;justify-content:space-between;gap:15px;padding:11px 5px;border-bottom:1px solid var(--line);text-decoration:none;font-size:16px;color:var(--ink)}.chapter-list>a:hover{color:var(--accent)}

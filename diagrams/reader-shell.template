/* 2026-10 adaptive-width correction.
   The previous 760px article + capped 1600px workspace formed a narrow strip on wide screens.
   Keep the two navigation rails independently scrollable, give the document a fluid reading area,
   and preserve explicit compact / comfortable / wide reader choices. */
:root {
  --measure: clamp(980px, 66vw, 1880px);
  --page-side: clamp(24px, 2.4vw, 60px);
}
:root[data-measure="comfortable"] { --measure: clamp(980px, 66vw, 1880px); }
:root[data-measure="narrow"] { --measure: 760px; }
:root[data-measure="wide"] { --measure: 100%; }

/* Do not cap the whole reading workspace at 1500/1600px. */
.reading-layout {
  width: calc(100% - var(--rail));
  max-width: none;
  margin-left: var(--rail);
  padding-left: var(--page-side);
  padding-right: var(--page-side);
  grid-template-columns: minmax(0, 1fr) clamp(194px, 10vw, 230px);
  column-gap: clamp(26px, 2vw, 44px);
}
.reading-main { width: 100%; min-width: 0; }
.reading-main > .article {
  width: 100%;
  max-width: var(--measure);
  margin-inline: auto;
}

/* Reading the whole book must not re-introduce the narrow original width. */
.complete-main {
  padding-left: var(--page-side);
  padding-right: var(--page-side);
}
.complete-main > .article {
  width: 100%;
  max-width: min(100%, clamp(1000px, 76vw, 2000px));
  margin-inline: auto;
}
.complete-main .standalone-section {
  width: 100%;
  max-width: min(100%, var(--measure));
}
.complete-main #index,
.complete-main #index .home-article { max-width: 100%; }
.home-article { width: 100%; max-width: min(100%, clamp(1100px, 80vw, 1900px)); }

/* The right outline is useful on very wide screens; at medium desktop widths
   the in-page collapsible outline replaces it, reserving room for the text. */
@media (max-width: 1599px) {
  .reading-layout {
    display: block;
    width: calc(100% - var(--rail));
    max-width: none;
    padding-inline: clamp(24px, 3vw, 48px);
  }
  .chapter-outline { display: none; }
  .mobile-outline { display: block; margin: 20px 0; }
}

/* Left rail slides away at tablet widths. Do not leave a phantom rail offset. */
@media (max-width: 1023px) {
  .reading-layout {
    width: 100%;
    margin-left: 0;
    padding-inline: clamp(24px, 3.8vw, 42px);
  }
  .complete-main { margin-left: 0; }
}
@media (max-width: 680px) {
  .reading-layout { padding-inline: 20px; }
  .complete-main { padding: 24px 20px 60px; }
}

/* Full-screen focus mode still respects user width preferences and fills the viewport. */
.is-focused .reading-layout {
  display: block;
  width: 100%;
  max-width: none;
  margin-left: 0;
  padding-inline: clamp(20px, 3vw, 72px);
}
.is-focused .reading-main > .article { max-width: var(--measure); }
.is-focused .complete-main { margin-left: 0; }

/* Printed pages should use their entire print area rather than a desktop column cap. */
@media print {
  .reading-layout, .complete-main { width: 100%; max-width: none; margin: 0; padding: 0; }
  .reading-main > .article, .complete-main > .article,
  .complete-main .standalone-section { width: 100%; max-width: none; }
}


.studio-icon{width:18px;height:18px;display:block;flex:none;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.icon-button{display:inline-flex;align-items:center;justify-content:center;height:36px;min-width:36px;border-color:transparent;background:transparent;padding:8px}.icon-button[aria-pressed=true]{background:#eaf0fa;color:var(--accent)}
/* A single workspace frame on the home, reading and reference pages. */
.site-header{height:var(--bar);display:flex;align-items:center;gap:20px;padding:0 24px;position:sticky;top:0;z-index:70;border-bottom:1px solid var(--line);background:var(--paper)}.site-brand{display:flex;align-items:center;gap:10px;color:var(--ink);font-size:16px;font-weight:650;text-decoration:none;white-space:nowrap;letter-spacing:0}.site-brand .book-mark{width:24px;height:24px;color:var(--ink)}.brand-detail{font-weight:400;color:var(--muted);font-size:12px;margin-left:8px;padding-left:14px;border-left:1px solid #dce1e7}.site-links{display:flex;align-items:center;height:100%;gap:26px;margin-left:25px;font-size:13px}.site-links a{display:flex;align-items:center;height:100%;text-decoration:none;color:var(--muted);border-bottom:2px solid transparent;padding-top:2px}.site-links a:hover,.site-links a[aria-current=page]{color:var(--ink);border-bottom-color:var(--ink)}.site-actions{display:flex;align-items:center;gap:8px;margin-left:auto}.search-trigger{display:flex;align-items:center;gap:10px;height:34px;width:225px;color:var(--muted);font-size:13px;text-align:left;background:#fafbfc;border:1px solid #e0e4e9}.search-trigger kbd{margin-left:auto;font-family:var(--ui);font-size:11px;border:1px solid #dee3e9;border-radius:3px;line-height:1.4;padding:1px 4px;color:#67727e;background:#fff}.search-trigger .studio-icon{height:15px;width:15px}.menu-trigger{display:none}.page-progress{position:fixed;top:calc(var(--bar) - 1px);height:1px;left:var(--rail);right:0;z-index:72;pointer-events:none}.page-progress span{display:block;height:100%;width:100%;background:var(--accent);transform:scaleX(0);transform-origin:left center}
/* The header of the rail does not scroll. Only .rail-scroll owns chapter scrolling. */
.book-rail{position:fixed;left:0;top:var(--bar);bottom:0;z-index:55;width:var(--rail);height:calc(100dvh - var(--bar));padding:0;overflow:hidden;display:flex;flex-direction:column;border-right:1px solid var(--line);background:#f7f8fa;font-size:13px;line-height:1.6}.rail-top{display:flex;flex:none;align-items:center;justify-content:space-between;padding:17px 18px 12px;margin:0;min-height:58px}.rail-top strong{font-size:13px;font-weight:650}.rail-actions{display:flex;gap:2px}.rail-locate{padding:5px 7px;font-size:11px;min-height:30px;border:0;background:transparent;color:var(--muted)}.rail-locate:hover{color:var(--accent)}.rail-close{display:none}.rail-scroll{min-height:0;flex:1;overflow-y:auto;overflow-x:hidden;padding:0 12px 26px;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#cfd5dd transparent;scroll-behavior:auto!important}.rail-scroll:focus{outline-offset:-3px}.rail-home{display:flex;align-items:center;gap:9px;padding:8px 10px;margin:1px 0;color:#4c5662;text-decoration:none;border-radius:4px;border-left:2px solid transparent;font-size:13px;min-height:34px}.rail-home .studio-icon{height:16px;width:16px}.rail-home.active{background:#eaf0fa;color:#1f4f9e;border-left-color:var(--accent);font-weight:600}.rail-group{margin:17px 0 0;border:0;padding:0}.rail-group>summary{list-style:none;display:flex;align-items:center;gap:8px;padding:7px 10px;min-height:34px;cursor:pointer;font-size:12px;font-weight:650;color:#2c3540}.rail-group>summary::-webkit-details-marker{display:none}.rail-group>summary:before{content:'';display:block;width:6px;height:6px;border-right:1.4px solid #747f8c;border-bottom:1.4px solid #747f8c;transform:rotate(-45deg);margin-right:3px;flex:none}.rail-group[open]>summary:before{transform:rotate(45deg);margin-top:-3px}.rail-group .group-count{font-variant-numeric:tabular-nums;font-weight:400;font-size:11px;color:#717b88;margin-left:auto}.rail-section-name{padding:14px 11px 5px;font-size:11px;line-height:1.7;color:#687381;font-weight:500
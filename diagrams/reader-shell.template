  const art=$('.vb-art'),caption=$('.vb-caption'),title=$('.vb-frame-title'),state=$('.vb-state'),equation=$('.vb-equation'),range=$('.vb-range'),status=$('.vb-status'),play=$('[data-vb-action="play"]'),prev=$('[data-vb-action="prev"]'),next=$('[data-vb-action="next"]'),speed=$('.vb-speed select');
  const stop=()=>{if(timer!==null){clearInterval(timer);timer=null;}play.textContent='播放';play.setAttribute('aria-pressed','false');el.dataset.playing='false';};
  function render(){const f=lesson.frames[i];art.innerHTML=(matchMedia('(max-width:680px)').matches&&f.mobileSvg)?f.mobileSvg:f.svg;title.textContent=`${i+1} / ${lesson.frames.length} · ${f.title}`;caption.textContent=f.explain;state.textContent=f.state||'本步状态由图形与说明共同给出。';equation.textContent=f.equation||'';equation.hidden=!f.equation;range.value=String(i);range.setAttribute('aria-valuetext',`${i+1} / ${lesson.frames.length}：${f.title}`);status.textContent=`第 ${i+1} 步，共 ${lesson.frames.length} 步`;prev.disabled=i===0;next.disabled=i===lesson.frames.length-1;el.dataset.frame=String(i);if(i===lesson.frames.length-1)stop();}
  function go(v){stop();i=Math.max(0,Math.min(lesson.frames.length-1,Number(v)||0));render();}
  function start(){if(timer!==null){stop();return;}players.forEach(p=>p.stop());if(i===lesson.frames.length-1)i=0;render();el.dataset.playing='true';play.textContent='暂停';play.setAttribute('aria-pressed','true');timer=setInterval(()=>{if(document.hidden){stop();return;}i=Math.min(i+1,lesson.frames.length-1);render();},Number(speed.value)||4200);}
  prev.addEventListener('click',()=>go(i-1));next.addEventListener('click',()=>go(i+1));play.addEventListener('click',start);$('[data-vb-action="reset"]').addEventListener('click',()=>go(0));range.addEventListener('input',()=>go(range.value));speed.addEventListener('change',()=>{const active=timer!==null;stop();if(active)start();});
  $('[data-vb-action="zoom"]').addEventListener('click',()=>{stop();dialog.querySelector('h2').textContent=lesson.title+' · '+lesson.frames[i].title;dialog.querySelector('.vb-art').innerHTML=lesson.frames[i].svg;dialog.querySelector('.vb-caption').textContent=lesson.frames[i].explain;if(dialog.showModal)dialog.showModal();else art.classList.toggle('vb-expanded');});
  el.addEventListener('keydown',e=>{if(e.target.matches('input,select,button,a'))return;if(e.key==='ArrowRight'){e.preventDefault();go(i+1);}if(e.key==='ArrowLeft'){e.preventDefault();go(i-1);}if(e.key===' '){e.preventDefault();start();}});
  const container=el.closest('.vb-block')||el.parentElement;container.querySelectorAll('[data-vb-jump]').forEach(b=>b.addEventListener('click',()=>{go(b.dataset.vbJump);el.scrollIntoView({block:'nearest',behavior:'auto'});el.focus({preventScroll:true});}));
  const p={el,stop,go,get index(){return i;}};players.push(p);render();return p;
 }
 document.querySelectorAll('[data-vb]').forEach(init);document.addEventListener('visibilitychange',()=>{if(document.hidden)players.forEach(p=>p.stop());});
 if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(en=>{if(!en.isIntersecting)players.find(p=>p.el===en.target)?.stop();}),{threshold:0});players.forEach(p=>observer.observe(p.el));}
 window.VisualBook={players,init};
})();
</script><script>/* Local numerical record viewer. No network, model execution, or automatic playback. */
(()=>{'use strict';
const frames=window.MODEL_FRAMES||[];const hosts=[...document.querySelectorAll('.mc-player')];
const ns='http://www.w3.org/2000/svg';
const fmt=(x,precision=6)=>typeof x==='boolean'?(x?'允许':'禁止'):Number.isInteger(x)?String(x):Number(x).toPrecision(precision).replace(/(\.\d*?[1-9])0+(?=e|$)/,'$1').replace(/\.0+(?=e|$)/,'');
function node(name,attrs={},text){const e=document.createElementNS(ns,name);for(const[k,v]of Object.entries(attrs))e.setAttribute(k,v);if(text!==undefined)e.textContent=text;return e;}
for(const host of hosts){let group='',i=0,list=[],timer=null;
 const select=host.querySelector('.mc-group'),range=host.querySelector('.mc-range'),play=host.querySelector('[data-mc=play]');
 const requested=(host.dataset.allowedGroups||'').split(',').filter(Boolean);const available=[...new Set(frames.map(f=>f.group))];const groups=requested.length?available.filter(g=>requested.some(r=>g.includes(r))):available; if(!groups.length)groups.push(...available);
 groups.forEach(g=>{const o=document.createElement('option');o.value=g;o.textContent=g;select.append(o);});
 function stop(){if(timer!==null)clearInterval(timer);timer=null;play.textContent='播放';play.setAttribute('aria-pressed','false');}
 function render(){if(!list.length)return;const f=list[i];host.dataset.frame=String(i);host.dataset.group=group;
  host.querySelector('.mc-count').textContent=`${i+1} / ${list.length}`;range.max=String(list.length-1);range.value=String(i);
  host.querySelector('.mc-run-label').textContent=f.input;
  host.querySelector('.mc-frame-title').textContent=f.title;
  host.querySelector('.mc-frame-note').textContent=f.description;
  host.querySelector('.mc-state').textContent=f.state;
  const rows=f.values.map(r=>Array.isArray(r)?r:[r]);const columns=f.columns||rows[0].map((_,j)=>`特征${j}`);
  const w=Math.max(660,155+rows[0].length*94),h=74+rows.length*46;
  const svg=node('svg',{viewBox:`0 0 ${w} ${h}`,role:'img','aria-label':f.group+'：'+f.title});svg.append(node('title',{},f.title));
  svg.append(node('rect',{x:0,y:0,width:w,height:h,fill:'#ffffff'}));
  columns.forEach((c,j)=>svg.append(node('text',{x:150+j*94+43,y:28,'text-anchor':'middle','font-size':14,fill:'#344963'},c)));
  rows.forEach((r,t)=>{svg.append(node('text',{x:10,y:66+t*46,'font-size':15,fill:'#344963'},f.rows?.[t]||`行${t}`));
   r.forEach((v,j)=>{svg.append(node('rect',{x:150+j*94,y:42+t*46,width:88,height:35,rx:3,fill:typeof v==='boolean'?(v?'#e4f0e9':'#edf0f3'):(Math.abs(v)>0?'#edf3f9':'#f5f6f8')}));svg.append(node('text',{x:150+j*94+44,y:66+t*46,'text-anchor':'middle','font-size':13,fill:'#183a5f'},fmt(v,4)));});});
  const art=host.querySelector('.mc-frame-figure');art.replaceChildren(svg);
  const wrap=document.createElement('div');wrap.className='table-wrap';const table=document.createElement('table'),thead=document.createElement('thead'),tr=document.createElement('tr');
  ['位置',...columns].forEach(c=>{const th=document.createElement('th');th.textContent=c;tr.append(th);});thead.append(tr);table.append(thead);const tbody=document.createElement('tbody');
  rows.forEach((r,t)=>{const tr=document.createElement('tr');const th=document.createElement('th');th.textContent=f.rows?.[t]||`行${t}`;tr.append(th);r.forEach(v=>{const td=document.createElement('td');td.textContent=fmt(v,10);tr.append(td);});tbody.append(tr);});table.append(tbody);wrap.append(table);host.querySelector('.mc-frame-table').replaceChildren(wrap);
  host.querySelector('[data-mc=prev]').disabled=i===0;host.querySelector('[data-mc=next]').disabled=i===list.length-1;
 }
 function choose(g){stop();group=g;list=frames.filter(f=>f.group===g);i=0;render();}
 select.addEventListener('change',()=>choose(select.value));range.addEventListener('input',()=>{stop();i=Number(range.value);render();});
 host.addEventListener('click',e=>{const b=e.target.closest('[data-mc]');if(!b)return;const act=b.dataset.mc;
  if(act==='play'){if(timer!==null){stop();return;}if(i===list.length-1)i=0;render();play.textContent='暂停';play.setAttribute('aria-pressed','true');timer=setInterval(()=>{if(i>=list.length-1){stop();return;}i++;render();if(i===list.length-1)stop();},2300);return;}
  stop();if(act==='prev')i=Math.max(0,i-1);if(act==='next')i=Math.min(list.length-1,i+1);if(act==='reset')i=0;render();
 });
 host.addEventListener('keydown',e=>{if(['INPUT','SELECT','BUTTON'].includes(e.target.tagName))return;if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();stop();i=Math.max(0,Math.min(list.length-1,i+(e.key==='ArrowRight'?1:-1)));render();}});
 document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});choose(groups[0]);
}
})();
</script><script>(()=>{'use strict';
const mm=(a,b)=>a.map(row=>b[0].map((_,j)=>row.reduce((sum,x,k)=>sum+x*b[k][j],0)));
const tr=a=>a[0].map((_,i)=>a.map(row=>row[i]));
const fmt=x=>Number.isFinite(x)?(Math.abs(x)<1e-12?'0':Number(x.toFixed(9)).toString()):'-∞';
const row=x=>'['+x.map(fmt).join(', ')+']';
const mat=x=>'['+x.map(row).join(',\n     ')+']';
document.querySelectorAll('[data-qkv-lab]').forEach(lab=>{
 const q=lab.querySelector('[data-qkv-q]'),v=lab.querySelector('[data-qkv-v]'),pos=lab.querySelector('[data-qkv-position]'),out=lab.querySelector('[data-qkv-output]');
 function run(){
  const qv=Number(q.value),vv=Number(v.value),i=Number(pos.value);
  if(!q.value.trim()||!v.value.trim()||!Number.isFinite(qv)||!Number.isFinite(vv)||Math.abs(qv)>5||Math.abs(vv)>20||![0,1].includes(i)){out.textContent='请使用有限数：Wq这一格在−5到5之间，Wv这一格在−20到20之间。';return;}
  const X=[[1,1],[1,-1]],Wq=[[qv,.5],[-.5,.5]],Wk=[[.5,.5],[.5,-.5]],Wv=[[vv,10],[5,-10]];
  const Q=mm(X,Wq),K=mm(X,Wk),V=mm(X,Wv),dots=mm(Q,tr(K))[i];
  const scores=dots.map((x,j)=>j<=i?x/Math.sqrt(2):-Infinity),m=Math.max(...scores),exp=scores.map(x=>Math.exp(x-m)),sum=exp.reduce((a,b)=>a+b,0),weights=exp.map(x=>x/sum),O=mm([weights],V)[0];
  out.textContent=`固定输入X = ${mat(X)}\n\n参数Wq = ${mat(Wq)}\n参数Wk = ${mat(Wk)}\n参数Wv = ${mat(Wv)}\n\n本次Q = XWq = ${mat(Q)}\n本次K = XWk = ${mat(K)}\n本次V = XWv = ${mat(V)}\n\n当前接收位置：${i}（${i===0?'我':'爱'}）\n当前q = ${row(Q[i])}\n与每行K的原始点积 = ${row(dots)}\n除以√2并屏蔽未来位置 = ${row(scores)}\n减去可读位置的最大分数 ${fmt(m)} 后取指数 = ${row(exp)}\n指数之和 = ${fmt(sum)}\n读取份额a = ${row(weights)}\n\n该行输出 = a × V = ${row(O)}\n第一格：${fmt(weights[0])}×${fmt(V[0][0])} + ${fmt(weights[1])}×${fmt(V[1][0])} = ${fmt(O[0])}\n第二格：${fmt(weights[0])}×${fmt(V[0][1])} + ${fmt(weights[1])}×${fmt(V[1][1])} = ${fmt(O[1])}\n\n权重矩阵W决定如何生成表示；份额a决定本次读入多少Value。上述结果是数值表示，不是最终Token。`;
  lab.dataset.result=JSON.stringify({Q,K,V,scores:scores.map(x=>Number.isFinite(x)?x:null),weights,output:O});
 }
 [q,v,pos].forEach(el=>{el.addEventListener('input',run);el.addEventListener('change',run)});
 lab.querySelector('[data-qkv-reset]').addEventListener('click',()=>{q.value='.5';v.value='5';pos.value='1';run()});run();
});
})();
</script></body></html>
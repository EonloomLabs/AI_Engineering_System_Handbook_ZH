/* 自检题：答案默认收起，读者主动展开；原生 details 支持键盘与无 JS 阅读。 */
.quiz-answer{margin:14px 0 0;font-size:15px;}
.quiz-answer summary{cursor:pointer;display:list-item;list-style-position:inside;max-width:max-content;padding:7px 13px;border:1px solid #b7d0c6;border-radius:7px;background:#f2f8f5;color:var(--accent);font-weight:650;user-select:none;}
.quiz-answer summary:hover{background:#e6f3ec;}
.quiz-answer summary:focus-visible{outline:3px solid #c38032;outline-offset:3px;}
.quiz-answer .when-open{display:none;}
.quiz-answer[open] .when-open{display:inline;}
.quiz-answer[open] .when-closed{display:none;}
.quiz-answer[open] summary{background:#edf4ee;}
.quiz-answer .answer{margin-top:10px;}
@media print{.quiz-answer:not([open]) .answer{display:none}}

/* Worked examples: input, state transitions and explicit boundaries. */
.worked-example{margin:32px 0;padding:24px 26px;border:1px solid #cbded7;border-left:4px solid #196b6b;border-radius:9px;background:#fff;clear:both;scroll-margin-top:92px}
.worked-label{font-size:12px;letter-spacing:.08em;color:#196b6b;font-weight:750;margin-bottom:8px}
.worked-example h3{font-size:21px;line-height:1.6;margin:6px 0 15px}.worked-example p{font-size:16px;line-height:1.95;margin:14px 0}.worked-setup{background:#f1f7f3;padding:15px 17px;border-radius:6px}
.worked-table{margin:18px 0}.worked-table table{table-layout:fixed;line-height:1.9;font-size:15px}.worked-table th:nth-child(1){width:22%}.worked-table th:nth-child(2){width:35%}.worked-table th:nth-child(3){width:43%}.worked-table td{overflow-wrap:anywhere;word-break:normal}.step-no{display:block;font-size:11px;font-weight:750;color:#196b6b;margin-bottom:3px}.worked-boundary{color:#52666e;background:#f7f7f3;padding:12px 15px;border-radius:6px}.worked-example .worked-citation{font-size:12px;color:#687a7f;line-height:1.9}.worked-related{font-size:14px!important}.worked-takeaway strong{color:#196b6b}
.example-nav{font-size:13px;margin:24px 0;padding:12px 16px;background:#edf5f1;border-radius:7px}.example-index-list{columns:2;column-gap:30px}.example-index-item{break-inside:avoid;display:block;padding:9px 0;font-size:15px}.matrix-block{margin:24px 0}.matrix-block h3{font-size:19px}.matrix-block p{font-size:15px}.matrix-grid{font-variant-numeric:tabular-nums;font-size:14px}.matrix-grid td{text-align:right;white-space:nowrap}.matrix-grid td:first-child{text-align:left}.tensor-caption{font-size:13px;color:#61717a}.validation-scope{background:#fff6e9;border-left:4px solid #b07832;padding:18px 22px;margin:24px 0}.example-code{font-size:13px}
@media(max-width:780px){.worked-example{padding:18px 16px;margin:26px 0}.worked-example h3{font-size:20px}.worked-example p{font-size:16px}.worked-table{border:0;border-radius:0;overflow:visible}.worked-table table,.worked-table tbody,.worked-table tr,.worked-table td{display:block;width:100%;min-width:0}.worked-table thead{display:none}.worked-table tr{border:1px solid #dce4e4;border-radius:7px;margin:13px 0;overflow:hidden}.worked-table td{border-bottom:0;padding:11px 13px}.worked-table td:first-child{background:#edf5f1;font-weight:700}.worked-table td:nth-child(2)::before{content:'内部动作';display:block;font-size:11px;color:#196b6b;font-weight:750}.worked-table td:nth-child(3)::before{content:'结果 / 状态';display:block;font-size:11px;color:#196b6b;font-weight:750}.step-no{display:inline;margin-right:8px}.example-index-list{columns:1}.matrix-grid{font-size:12px}.matrix-grid td{padding:8px}.worked-setup{padding:12px}.matrix-block{max-width:100%}}
@media print{.worked-example{break-inside:auto;background:#fff;padding:12px;border-color:#aaa}.worked-table table{font-size:10pt}.worked-label,.worked-citation{color:#333}.worked-related{display:none}}

/* 对象身份与首次出现说明 */
.concept-note{margin:20px 0;padding:16px 20px;border:1px solid #d8e3dd;border-left:3px solid #4e7970;background:#f4f8f5;border-radius:7px;font-size:15px;line-height:1.85}

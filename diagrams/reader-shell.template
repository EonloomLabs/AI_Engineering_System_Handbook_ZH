.concept-index-links{display:flex;gap:9px;flex-wrap:wrap;font-size:13px;margin:22px 0}.concept-index-links a{display:inline-block;padding:5px 9px;border:1px solid var(--line);border-radius:5px;text-decoration:none;background:#fff}

const $=s=>document.querySelector(s)||(s.startsWith("#")?document.querySelector(`[id$="--${s.slice(1)}"]`):null);const $$=s=>Array.from(document.querySelectorAll(s));
const memory=new Map();let storageOK=true;const store={get(k){try{return localStorage.getItem('ai-systems-textbook:'+k)??memory.get(k)??null}catch(e){storageOK=false;return memory.get(k)??null}},set(k,v){memory.set(k,v);try{localStorage.setItem('ai-systems-textbook:'+k,v)}catch(e){storageOK=false}}};
let size=Number(store.get('font'))||parseFloat(getComputedStyle(document.body).fontSize)||18;
function applySize(){document.documentElement.style.setProperty('--font',size+'px');store.set('font',String(size))}
if(store.get('font'))applySize();
$$('[data-font]').forEach(b=>b.addEventListener('click',()=>{size=Math.max(15,Math.min(24,size+Number(b.dataset.font)));applySize()}));
const menu=$('[data-menu]');if(menu)menu.addEventListener('click',()=>{const open=document.body.classList.toggle('nav-open');menu.setAttribute('aria-expanded',String(open))});
$$('.sidebar a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('nav-open')));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.body.classList.remove('nav-open');menu?.setAttribute('aria-expanded','false')}});
$$('[data-mark]').forEach(b=>{const key=b.dataset.mark;const render=()=>{const yes=store.get(key)==='read';b.textContent=yes?'✓ 已读：再次点击撤销':'标记本节已读';b.setAttribute('aria-pressed',String(yes));if(!storageOK){const note=b.parentElement.querySelector('.read-status');if(note)note.textContent='浏览器未允许本地存储；当前页面内标记仍可用。'}};render();b.addEventListener('click',()=>{store.set(key,store.get(key)==='read'?'':'read');render()})});
const sg=$('#search-input');if(sg){const result=$('#search-results'), count=$('#search-summary');
function search(){const q=sg.value.trim().toLowerCase();result.replaceChildren();if(!q){count.textContent='输入中文、英文、题号或符号，例如：张量、F05、Q025、unknown。';return}
const parts=q.split(/\s+/).filter(Boolean);const data=window.COURSE_SEARCH||[];
const found=data.map(d=>{const txt=(d.title+' '+d.text).toLowerCase();let score=0;for(const w of parts){if(!txt.includes(w))return null;score+=d.title.toLowerCase().includes(w)?15:1;if(d.id.toLowerCase()===w)score+=30}return {d,score}}).filter(Boolean).sort((a,b)=>b.score-a.score);
count.textContent=`找到 ${found.length} 项，显示前 ${Math.min(70,found.length)} 项。结果按相关程度排列。`;
for(const {d} of found.slice(0,70)){const div=document.createElement('section');div.className='search-result';const h=document.createElement('h3');const a=document.createElement('a');a.href=d.path;a.textContent=d.title;h.append(a);const tag=document.createElement('span');tag.className='badge';tag.textContent=d.kind;const p=document.createElement('p');let i=d.text.toLowerCase().indexOf(parts[0]);i=Math.max(0,i-38);p.textContent=(i?'…':'')+d.text.slice(i,i+185)+(d.text.length>i+185?'…':'');div.append(tag,h,p);result.append(div)}

}
let timer;sg.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(search,140)});$('#search-button')?.addEventListener('click',search);
search();}
// 实验一：只计算大小，不实际申请百万元素，安全范围内显示精确整数。
const shapeForm=$('#shape-form');if(shapeForm){function run(){const vals=['batch','tokens','width','bytes'].map(x=>Number($('#'+x).value));const out=$('#shape-output');if(vals.some(x=>!Number.isSafeInteger(x)||x<1)||!Number.isSafeInteger(vals.reduce((a,b)=>a*b,1))){out.textContent='请填正整数，并使乘积不超过安全整数范围。';return}const[b,t,d,bytes]=vals;out.textContent=`编号表：[${b},${t}]，共 ${(b*t).toLocaleString()} 个整数。查表结果：[${b},${t},${d}]，共 ${(b*t*d).toLocaleString()} 个数。若每数 ${bytes} 字节，这份输出占 ${(b*t*d*bytes).toLocaleString()} 字节，约 ${(b*t*d*bytes/1048576).toFixed(4)} MiB。`}
shapeForm.addEventListener('input',run);run();}

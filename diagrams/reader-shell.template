/* Long-form technical typography. */
.reading-layout{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:36px;margin-left:var(--rail);padding:0 34px 0 48px;max-width:1500px}.reading-main{min-width:0;padding:34px 0 76px}.article{max-width:var(--measure);min-width:0;margin:0 auto;overflow-wrap:break-word;color:var(--ink)}.article>.breadcrumb{margin:0 0 23px;font-size:12px;line-height:1.5;color:#66717e}.breadcrumb a{color:#657182;text-decoration:none}.article>.eyebrow,.article>.term-guide{display:none}.article h1{font-family:var(--ui);font-size:30px;font-weight:650;line-height:1.5;letter-spacing:-.015em;text-wrap:pretty;margin:0 0 20px}.article h2{font-family:var(--ui);font-size:23px;font-weight:650;line-height:1.65;letter-spacing:0;border:0;padding:0;margin:46px 0 18px;text-wrap:pretty}.article h3{font-size:19px;font-weight:650;line-height:1.7;margin:27px 0 12px}.article h4{font-size:17px;line-height:1.8;font-weight:650;margin:23px 0 10px}.article p{margin:17px 0;color:var(--ink);font-size:1em}.article .lead{font-size:16px;line-height:1.95;color:#59636e;margin:0 0 23px}.article li{margin:9px 0}.article ul,.article ol{padding-left:1.45em}.article strong{font-weight:650}.article .small,.article .source-note,.article .end-note,.article .source-raw{font-size:13px;line-height:1.85;color:var(--muted)}.article .source-note{border-top:1px solid var(--line);padding-top:18px;margin-top:30px}.article .term{color:inherit;text-decoration:underline dotted #9da7b3;text-underline-offset:4px}.source-ref{font-size:12px;color:#4b67a1;text-decoration:none}.reading-meta{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:12px;color:#68727f;margin:-6px 0 21px}.reading-meta .meta-kind{background:none;border:0;padding:0;color:#59636e}.reading-meta span+span:before{content:'·';margin-right:16px;color:#a0a7af}.chapter-outline{position:sticky;align-self:start;top:calc(var(--bar) + 32px);height:calc(100dvh - var(--bar) - 60px);overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:#d1d7df transparent;padding:0 0 16px;font-size:12px}.outline-label{font-size:12px;font-weight:600;color:#424c59;margin:0 0 13px}.chapter-outline .toc{border:0;background:none;padding:0;margin:0;border-radius:0}.chapter-outline .toc-title{display:none}.chapter-outline .toc a{display:block;padding:6px 0 6px 12px;border-left:1px solid #e0e5eb;color:#67727f;font-size:12px;text-decoration:none;line-height:1.75;overflow-wrap:anywhere}.chapter-outline .toc a.sub{padding-left:19px;font-size:12px}.chapter-outline .toc a:hover,.chapter-outline .toc a.is-current{color:var(--accent);border-left:2px solid var(--accent);padding-left:11px}.chapter-outline .toc a.sub.is-current{padding-left:18px}.outline-tools{display:flex;flex-direction:column;gap:4px;margin-top:20px;padding-top:17px;border-top:1px solid var(--line)}.outline-tools button{text-align:left;background:none;border:0;font-size:12px;color:var(--muted);padding:5px 0}.mobile-outline{display:none}

.skip-link{position:absolute;top:-60px;left:16px;padding:10px;background:#fff;z-index:100}.skip-link:focus{top:8px}
.book-subtitle{font-size:13px;letter-spacing:.08em;color:var(--muted)}
.route-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:24px 0}
.route-card{padding:21px 23px;border-left:3px solid var(--accent);background:#f1f5f1;border-radius:0 8px 8px 0}

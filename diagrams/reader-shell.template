.toc .toc-title{margin:0 0 10px}.toc h2{border:0;font-size:16px;margin:0}.toc a{overflow-wrap:anywhere}.article p,.article li,.article td{overflow-wrap:break-word}.article pre{overflow-wrap:normal}.article .badge{font-size:12px}.standalone-section{scroll-margin-top:80px}.standalone-section>h1{font-size:30px}.source-raw{word-break:break-all}
